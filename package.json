{
  "name": "Albert",
  "version": "1.0.0",
  "description": "Professional Node.js backend application",
  "main": "src/index.js",
  "scripts": {
  "dev": "nodemon src/backend/server.js",
  "start": "node src/backend/server.js",
  "test": "node --test tests/backend",
  "lint": "eslint src/backend tests --ext .js",
  "format": "prettier --write \"src/backend/**/*.js\" \"tests/**/*.js\"",
  "prepare": "husky"
  }, 
  "keywords": [
    "nodejs",
    "express",
    "backend",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.9.10",
    "supertest": "^6.3.4"
  },
  "lint-staged": {
  "src/backend/**/*.js": [
    "eslint --fix",
    "prettier --write"
  ],
  "tests/**/*.js": [
    "eslint --fix",
    "prettier --write"
  ],
  "src/frontend/src/**/*.{js,jsx}": [
    "prettier --write"
  ]
}
}
